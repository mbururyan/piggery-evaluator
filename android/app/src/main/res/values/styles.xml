<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app process starts, before Flutter draws its first
         frame. White, so it runs straight into the white Flutter splash
         with no flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Set natively because Flutter's SystemChrome request came too
             late or was ignored on the Infinix (the bar stayed black). -->
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Applies once the app is running, behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- White bar with dark buttons, to match the white bottom nav. -->
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>